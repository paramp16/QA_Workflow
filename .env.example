# Choose mock for a dependency-free smoke test, or gemini/anthropic/ollama.
MODEL_PROVIDER=mock

# Required when MODEL_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Use a mounted persistent directory in production.
QA_DB_PATH=logs/qa_log.db

# Set this when Tesseract is installed outside the default PATH.
TESSERACT_CMD=